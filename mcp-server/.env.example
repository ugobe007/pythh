# Supabase (same project as main Pythh backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# MCP server config
PORT=8080
MCP_SERVER_NAME=pythh-connect
MCP_SERVER_VERSION=1.0.0

# Optional: forward URL scoring to Fly.io backend
PYTHH_API_URL=https://hot-honey.fly.dev

# Plain-text token from the OpenAI plugin domain verification step.
# fly secrets set OPENAI_APPS_CHALLENGE_TOKEN=... --app pythh-connect-mcp
OPENAI_APPS_CHALLENGE_TOKEN=
