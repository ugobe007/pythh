{
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hot-honey.fly.dev/api/:path*"
    },
    {
      "source": "/((?!assets/|images/|favicon|apple-touch-icon|og-image|icon-512|site\\.webmanifest|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
